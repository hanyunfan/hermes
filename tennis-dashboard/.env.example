# =========================================================
# Tennis Dashboard - environment template
# Copy this to .env and fill in real values. NEVER commit .env.
# =========================================================

# --- Home location ---
HOME_ZIP=78750
HOME_LAT=30.5490
HOME_LNG=-97.7805
HOME_RADIUS_MILES=80

# --- Active Communities (Anderson Mill) ---
# Find these by logging in to https://anc.apm.activecommunities.com/andersonmill/
# and inspecting localStorage / cookies. Leave blank to disable auto-booking.
ANC_USERNAME=
ANC_PASSWORD=
ANC_DEFAULT_COURT=tennis_court_1
ANC_DEFAULT_DURATION_MIN=60

# --- UTR (myutr.com / utrsports.net) ---
# Player ID from your daughter's UTR profile URL.
UTR_PLAYER_ID=
# UTR API base (rarely changes)
UTR_API_BASE=https://api.utrsports.net

# --- USTA TennisLink ---
# TennisLink member ID (number from your USTA profile URL)
USTA_MEMBER_ID=
USTA_SECTION=texas

# --- Booking behavior ---
# Slack/Telegram webhook for booking notifications (optional)
NOTIFY_WEBHOOK=
# Playwright browser profile (set to your daily-use Chrome profile path
# with the USTA/UTR/ANC sites already logged in). Speeds up auth significantly.
CHROME_USER_DATA_DIR=